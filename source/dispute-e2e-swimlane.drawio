        <mxCell id="t2" value="One flow, eight lanes, five phases. The platform orchestrates every decision; the scheme platforms execute recovery. Nothing reaches the acquirer except through a scheme." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#475569;" vertex="1" parent="L0"><mxGeometry x="24.0" y="44.0" width="1900.0" height="20.0" as="geometry"/></mxCell>
