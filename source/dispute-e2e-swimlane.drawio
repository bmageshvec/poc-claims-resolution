        <mxCell id="gut4" value="&lt;b&gt;DRS · Scheme Adapters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;file · poll · fan-out · reconcile&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="L0"><mxGeometry x="0.0" y="654.0" width="212.0" height="116.0" as="geometry"/></mxCell>
