        <mxCell id="gut7" value="&lt;b&gt;Acquirer &amp;amp; Merchant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;reached only through the scheme&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#CBD5E1;align=left;verticalAlign=middle;spacingLeft=14;fontSize=11.5;fontColor=#0F172A;" vertex="1" parent="L0"><mxGeometry x="0.0" y="1024.0" width="212.0" height="104.0" as="geometry"/></mxCell>
        <mxCell id="ph0" value="&lt;b&gt;PHASE 1 · CAPTURE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;Cardholder raises it; the platform proves it is a real, in-window, non-duplicate claim&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1F4;strokeColor=#0E7490;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12.5;fontColor=#0E7490;" vertex="1" parent="L0"><mxGeometry x="212.0" y="74.0" width="352.0" height="58.0" as="geometry"/></mxCell>
        <mxCell id="ph1" value="&lt;b&gt;PHASE 2 · AUTO-RESOLVE &amp;amp; TRIAGE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;Rules decide: settle it now, credit provisionally, or send it to an analyst&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7F1F0;strokeColor=#0F766E;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12.5;fontColor=#0F766E;" vertex="1" parent="L0"><mxGeometry x="566.0" y="74.0" width="352.0" height="58.0" as="geometry"/></mxCell>
        <mxCell id="sep1" style="endArrow=none;html=1;strokeColor=#94A3B8;dashed=1;dashPattern=5 5;" edge="1" parent="L0"><mxGeometry relative="1" as="geometry"><mxPoint x="566" y="140" as="sourcePoint"/><mxPoint x="566" y="1128" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ph2" value="&lt;b&gt;PHASE 3 · PRE-DISPUTE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;Try to close it without a chargeback — alerts, deflection, merchant inquiry&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8EEE6;strokeColor=#B45309;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12.5;fontColor=#B45309;" vertex="1" parent="L0"><mxGeometry x="920.0" y="74.0" width="378.0" height="58.0" as="geometry"/></mxCell>
        <mxCell id="sep2" style="endArrow=none;html=1;strokeColor=#94A3B8;dashed=1;dashPattern=5 5;" edge="1" parent="L0"><mxGeometry relative="1" as="geometry"><mxPoint x="920" y="140" as="sourcePoint"/><mxPoint x="920" y="1128" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ph3" value="&lt;b&gt;PHASE 4 · DISPUTE — FILE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;Build the evidence pack, route to the right scheme, file it, poll for the answer&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E7EFF7;strokeColor=#1061B0;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12.5;fontColor=#1061B0;" vertex="1" parent="L0"><mxGeometry x="1300.0" y="74.0" width="348.0" height="58.0" as="geometry"/></mxCell>
        <mxCell id="sep3" style="endArrow=none;html=1;strokeColor=#94A3B8;dashed=1;dashPattern=5 5;" edge="1" parent="L0"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="140" as="sourcePoint"/><mxPoint x="1300" y="1128" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="ph4" value="&lt;b&gt;PHASE 5 · RECOVER&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;Pre-arbitration, arbitration, appeal — executed in VROL/MCOM, orchestrated here&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2EAF9;strokeColor=#7B2CBF;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12.5;fontColor=#7B2CBF;" vertex="1" parent="L0"><mxGeometry x="1650.0" y="74.0" width="398.0" height="58.0" as="geometry"/></mxCell>
