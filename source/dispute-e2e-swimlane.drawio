        <mxCell id="n_b2" value="&lt;b&gt;Customer master&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9.5px&quot; color=&quot;#475569&quot;&gt;contact · KYC · card&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#0F172A;fontStyle=0;fillColor=#EEF2F7;strokeColor=#64748B;strokeWidth=1.3;" vertex="1" parent="L1"><mxGeometry x="397.0" y="274.0" width="153.0" height="56.0" as="geometry"/></mxCell>
